# Gitea WebHook：在仓库「设置 → Webhooks → 添加 Gitea」填写同一个 Secret。
GITEA_WEBHOOK_SECRET=
# 其他代码托管平台的 Webhook 密钥。只填写自己使用的平台。
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
GITEE_WEBHOOK_SECRET=
# PostgreSQL 16。正式环境使用独立账号与数据库；应用不会自动执行迁移或种子。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arbor
# 应用日期和提醒计算的 IANA 时区，所有浏览器使用同一个时区。
APP_TIMEZONE=Asia/Shanghai
# 对外完整地址，生产使用 https；OAuth 回调为此地址 + /api/auth/feishu/callback。
APP_BASE_URL=http://localhost:3000
# 可选飞书企业自建网页应用凭证，仅用于服务端。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 必须精确为 true 才开放演示身份登录、身份切换和重置。正式环境设为 false。
DEMO_MODE=false
# 仅精确 true 才开启进程内提醒调度，默认关闭。多实例由 PostgreSQL advisory lock 互斥。
RUN_SCHEDULER=false
# 独立部署时启用本地账号登录，与飞书登录可以同时启用。
LOCAL_AUTH_ENABLED=false
# 空账号库首次初始化使用。用 openssl rand -hex 32 生成，初始化后可移除。
LOCAL_AUTH_SETUP_TOKEN=
